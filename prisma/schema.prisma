generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// API 키 저장 (사용자/워크스페이스별)
model ApiKey {
  id          String     @id @default(cuid())
  service     String     @unique // "youtube" | "openai" | "deepl" | "tiktok"
  value       String
  verified    Boolean    @default(false)
  
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// 파이프라인 영상 (소재수집 → 배포 전 과정)
model PipelineVideo {
  id           String   @id @default(cuid())
  title        String
  channel      String
  channelId    String?  // YouTube 채널 ID (원작자 연락용)
  originalUrl  String
  ytVideoId    String?  // YouTube 영상 ID
  views        String?
  likes        String?
  duration     String?
  subs         String?  // 원작자 구독자 수
  lang         String?  // 원작자 언어 (en, ja, es 등)
  grade        String   @default("B") // "S" | "A" | "B"
  score        Int      @default(70)
  niche        String?
  stage             String   @default("발굴 대기") // 7단계: 발굴 대기 → 요약 편집 → HD 저장 → 자막 추출 → 한글 변환 → 대본 생성 → 배포 완료
  aiReason          String?  @db.Text
  scriptJson        String?  @db.Text   // 생성된 타임라인 대본 JSON
  titleKo           String?  // AI 생성 제목
  thumbCopyTop      String?
  thumbCopyBot      String?
  hasCC             Boolean  @default(false)
  thumbnail         String?
  transcriptJson    String?  @db.Text   // Whisper 추출 원본 자막 JSON
  translatedJson    String?  @db.Text   // 한글 변환된 자막 JSON
  processedVideoUrl String?             // FFmpeg 처리된 HD 영상 경로/URL
  summaryDuration   Int?                // 요약 편집 영상 길이 (초)
  
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  publishes    PublishRecord[]
  outreaches   CreatorOutreach[]
  editClips    EditClip[]
}

// 원작자 알림 기록 (댓글 / 이메일 / DM)
model CreatorOutreach {
  id           String        @id @default(cuid())
  video        PipelineVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId      String
  type         String        // "comment" | "email" | "dm"
  lang         String        // 메시지 언어 (en, ja, es 등)
  message      String        @db.Text  // 전송 메시지 내용
  status       String        @default("draft") // "draft" | "sent" | "replied" | "approved"
  sentAt       DateTime?
  createdAt    DateTime      @default(now())
}

// 재편집용 클립 (원본 영상의 특정 구간)
model EditClip {
  id           String        @id @default(cuid())
  video        PipelineVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId      String
  order        Int           @default(0)  // 클립 순서
  startTime    String        // "00:01:30"
  endTime      String        // "00:02:45"
  label        String?       // "훅", "반응", "나레이션" 등
  note         String?  @db.Text  // 메모
  thumbnailUrl String?       // 캡처된 프레임 URL
  included     Boolean       @default(true) // 최종 편집에 포함 여부
  createdAt    DateTime      @default(now())
}

// 배포 기록
model PublishRecord {
  id         String        @id @default(cuid())
  video      PipelineVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId    String
  platform   String        // "youtube" | "shorts" | "tiktok" | "reels"
  platformId String?       // 업로드 후 받은 플랫폼 영상 ID
  status     String        @default("pending") // "pending" | "uploaded" | "failed"
  publishedAt DateTime?
  createdAt  DateTime      @default(now())
}

// 연동된 유튜브 채널
model Channel {
  id          String   @id @default(cuid())
  platform    String   // "youtube" | "tiktok" | "instagram"
  handle      String
  channelId   String?
  accessToken String?
  
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 생성된 AI 대본 저장
model Script {
  id             String   @id @default(cuid())
  videoId        String               // YouTube 영상 ID
  videoTitle     String               // 원본 영상 제목
  channelTitle   String?              // 원본 채널명
  hasTranscript  Boolean  @default(false) // 실제 자막 기반 여부
  title          String               // AI 생성 제목
  thumbnailTop   String?              // 썸네일 상단 카피
  thumbnailBottom String?             // 썸네일 하단 카피
  scriptJson     String   @db.Text    // ScriptLine[] JSON
  sceneCount     Int      @default(0) // 씬 수
  
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------
// NextAuth & Multi-tenant (SaaS) Models
// ---------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?   // For credentials provider
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // 회원이 소속된 워크스페이스 목록
  workspaceMembers WorkspaceMember[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String   // 기관명, 팀명 등
  slug        String   @unique
  logoUrl     String?  // 워크스페이스 로고
  
  members     WorkspaceMember[]
  
  // 격리 데이터
  apiKeys     ApiKey[]
  videos      PipelineVideo[]
  channels    Channel[]
  scripts     Script[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        Role      @default(MEMBER)
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId])
}
